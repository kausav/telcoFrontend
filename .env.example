# Base URL of the ModelOS backend (FastAPI). The backend must allow this UI's origin in CORS_ALLOW_ORIGINS.
# Use "same-origin" when the backend serves this UI itself (the single-container image): requests then go to the page's own address.
VITE_API_HOST=http://localhost:8000
# Static API token (the backend's API_STATIC_TOKENS). Compiled into the public bundle: development only. In the single-container image
# the server hands the token to the page at run time instead (UI_API_TOKEN), so leave this unset there.
# VITE_API_TOKEN=
# Country preselected in the Country dropdown (a code from GET /catalog/countries).
VITE_DEFAULT_COUNTRY=IN
# The ModelOS platform this module belongs to; the ModelOS logo in the header links here (this is the default).
VITE_PLATFORM_URL=http://modelos-dashboard.s3-website.ap-south-1.amazonaws.com/#/

# Single container: any VITE_* variable set on the running service overrides the value built into the app (see src/lib/appConfig.ts),
# so one image can serve dev, test and prod with different settings. These values are visible to anyone who loads the page.
